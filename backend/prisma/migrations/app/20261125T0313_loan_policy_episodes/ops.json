        "sql": "CREATE TABLE \"public\".\"ajustes_incumplimiento\" (\n  \"actor\" jsonb NOT NULL,\n  \"calendarioAnterior\" jsonb NOT NULL,\n  \"calendarioPosterior\" jsonb NOT NULL,\n  \"contexto\" jsonb NOT NULL,\n  \"createdAt\" timestamptz(3) DEFAULT (now()) NOT NULL,\n  \"descuentoEfectivo\" numeric(5,2) NOT NULL,\n  \"duracionTotalDias\" int4,\n  \"efecto\" character varying(20) NOT NULL,\n  \"fechaEfectiva\" timestamptz(3) NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"incrementoDias\" int4,\n  \"incrementoNominal\" numeric(5,2),\n  \"incumplimientoId\" uuid NOT NULL,\n  \"nominalObjetivo\" numeric(5,2),\n  \"saldoAnterior\" numeric(5,2) NOT NULL,\n  \"saldoPosterior\" numeric(5,2) NOT NULL,\n  \"severidad\" character varying(40) NOT NULL,\n  \"versionReglaId\" uuid NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"ajustes_efecto_check_bddadac4\" CHECK ((efecto = 'SET_ZERO' AND \"nominalObjetivo\" IS NULL AND \"incrementoNominal\" IS NULL AND \"duracionTotalDias\" IS NULL AND \"incrementoDias\" IS NULL AND \"saldoPosterior\" = 0) OR (efecto = 'DISCOUNT' AND \"nominalObjetivo\" BETWEEN 0 AND 100 AND \"incrementoNominal\" BETWEEN 0 AND \"nominalObjetivo\" AND \"duracionTotalDias\" > 0 AND \"incrementoDias\" BETWEEN 0 AND \"duracionTotalDias\")),\n  CONSTRAINT \"ajustes_saldos_check_2259aaf4\" CHECK (\"descuentoEfectivo\" >= 0 AND \"saldoAnterior\" BETWEEN 0 AND 100 AND \"saldoPosterior\" BETWEEN 0 AND 100 AND \"saldoAnterior\" - \"saldoPosterior\" = \"descuentoEfectivo\")\n)",
