        "description": "create table \"reservas\"",
        "sql": "CREATE TABLE \"public\".\"reservas\" (\n  \"fechaCancelacion\" timestamptz(3),\n  \"createdAt\" timestamptz(3) DEFAULT (now()) NOT NULL,\n  \"ejemplarId\" uuid NOT NULL,\n  \"estado\" text DEFAULT 'CONFIRMADA' NOT NULL,\n  \"fechaLimiteRecogida\" timestamptz(3) NOT NULL,\n  \"duracionPrestamoHoras\" int4 NOT NULL,\n  \"fechaRecogida\" timestamptz(3),\n  \"fechaSolicitada\" timestamptz(3) NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"motivoCancelacion\" text,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"usuarioId\" uuid NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"reservas_estado_check_c75da3fc\" CHECK (\"estado\" IN ('CONFIRMADA', 'RECOGIDA', 'CANCELADA', 'VENCIDA'))\n)",
        "params": []
      }
    ],
